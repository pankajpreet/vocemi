# Public website links
NEXT_PUBLIC_BOOK_CALL_URL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_LEAD_FORM_URL=

# Retell live voice demo
NEXT_PUBLIC_RETELL_PUBLIC_KEY=
NEXT_PUBLIC_RETELL_VOICE_AGENT_ID=
NEXT_PUBLIC_RETELL_RECAPTCHA_KEY=

# Free-trial form. Read on the server only. If this is unset, the form
# returns a clear error and does not pretend the signup was sent.
N8N_TRIAL_WEBHOOK_URL=

# Booking links. If either is unset, that button uses NEXT_PUBLIC_BOOK_CALL_URL
# (or /contact when that is unset too). Cal.com links still receive UTMs.
# KICKOFF_BOOKING_URL is the 15-minute call after a trial signup.
# AUDIT_BOOKING_URL is "Book a free audit" / "Get a free missed-call audit".
KICKOFF_BOOKING_URL=
AUDIT_BOOKING_URL=

# Contact form delivery through Resend
RESEND_API_KEY=
# Example after verifying vocemi.com in Resend:
# CONTACT_FROM_EMAIL=Vocemi Website <website@vocemi.com>
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=business@vocemi.com
