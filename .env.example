# Public website links
NEXT_PUBLIC_BOOK_CALL_URL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_LEAD_FORM_URL=

# Retell live voice demo
NEXT_PUBLIC_RETELL_PUBLIC_KEY=
NEXT_PUBLIC_RETELL_VOICE_AGENT_ID=
NEXT_PUBLIC_RETELL_RECAPTCHA_KEY=

# Contact form delivery through Resend
RESEND_API_KEY=
# Example after verifying vocemi.com in Resend:
# CONTACT_FROM_EMAIL=Vocemi Website <website@vocemi.com>
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=business@vocemi.com

# --- Oct 2026 offer --------------------------------------------------------
# The "Call our AI" line. Call buttons stay hidden until this is a real number.
NEXT_PUBLIC_DEMO_NUMBER=
# 15-minute kickoff call shown after a free-trial signup.
NEXT_PUBLIC_KICKOFF_BOOKING_URL=
# "Book a free audit" buttons. Falls back to NEXT_PUBLIC_BOOK_CALL_URL.
NEXT_PUBLIC_AUDIT_BOOKING_URL=
# Feature flags (true/false).
NEXT_PUBLIC_SHOW_JAGDEEP_REFERENCE=true
NEXT_PUBLIC_SHOW_SCALE_DASHBOARD=true
# Optional white-label token from the voice demo provider. Removes its credit line.
NEXT_PUBLIC_VOICE_WIDGET_WHITE_LABEL=

# Free-trial form delivery (server only, never exposed to the browser).
# The production webhook URL of the n8n "Vocemi trial signup" workflow.
N8N_TRIAL_WEBHOOK_URL=
# Shared secret sent as the X-Vocemi-Secret header; must match the workflow.
N8N_TRIAL_WEBHOOK_SECRET=
